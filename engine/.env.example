# Salin ke .env lalu isi. File .env tidak ikut ke git.

# Gateway model AI (wajib untuk `single` dan `leader`; follower tidak butuh).
VIKEY_API_BASE=https://api.vikey.ai/v1
VIKEY_API_KEY=

# Mode banyak: token rahasia yang SAMA di leader dan semua follower.
# Buat dengan: openssl rand -hex 16
BOT_HUB_TOKEN=
# Alamat hub untuk follower (dicetak leader saat mulai), mis. http://192.168.1.24:8765
BOT_HUB_URL=

# Windows saja: path lengkap Binance.exe bila tidak ditemukan otomatis.
# BOT_APP_PATH=C:\Users\NAMA\AppData\Local\Programs\Binance\Binance.exe
