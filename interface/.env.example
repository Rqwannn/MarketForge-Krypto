# Pengaturan aplikasi desktop, diisi ADMIN sekali per laptop (salin menjadi interface/.env).
# Nilai di sini diteruskan ke engine dan menimpa engine/.env. Jangan di-commit.

# Analisis AI (laptop mode Sendiri dan Leader)
VIKEY_API_BASE=
VIKEY_API_KEY=

# Mode banyak laptop: token sama di semua laptop (buat dengan `make token`)
BOT_HUB_TOKEN=
# Hanya laptop Follower: alamat hub laptop Leader, mis. http://192.168.1.24:8765
BOT_HUB_URL=

# Hash password admin untuk `make leader-key` (atur dengan `make leader-password`; yang disimpan
# hanya hash scrypt, bukan password-nya). Hanya di laptop admin/pemimpin.
BOT_LEADER_PASSWORD_HASH=

# Kunci pemimpin (buat sekali dengan `make leader-key` di laptop pemimpin).
# Hanya laptop pemimpin: kunci privat. Tanpa ini peran Pemimpin terkunci.
BOT_LEADER_KEY=
# Semua laptop pengikut: kunci publik pemimpin (untuk memverifikasi ajakan dan sinyal putaran).
BOT_LEADER_PUBLIC=
